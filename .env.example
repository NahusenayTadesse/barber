# Email (used to send students their payment links from Enrollments)
# Gmail: smtp.gmail.com, port 465, and an App Password (not your normal password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Optional: defaults to SMTP_USER
SMTP_FROM="D&D Barber Academy <bookings@example.com>"
SMTP_REPLY_TO=""
